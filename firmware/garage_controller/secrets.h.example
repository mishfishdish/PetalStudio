#pragma once

// Copy this file to secrets.h and fill in your values. Never commit secrets.h.
#define WIFI_SSID "your-wifi-name"
#define WIFI_PASSWORD "your-wifi-password"

// Must exactly match GARAGE_API_KEY on the WebSocket relay host.
#define GARAGE_API_KEY "use-a-long-random-secret-here"

// WebSocket relay address. Do not include wss:// in the host.
#define WEBSOCKET_HOST "your-relay.example.com"
#define WEBSOCKET_PORT 443
#define WEBSOCKET_PATH "/garage"
